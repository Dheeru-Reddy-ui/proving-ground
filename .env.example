# Copy to .env (gitignored) and fill in. Never commit .env or put secrets anywhere else.

# --- Game and device (Phase 0+) ---
# Unity project for TrashCat, kept OUTSIDE this repo; read-only except the edits listed in game/HOOKS.md
PG_GAME_PROJECT_DIR=C:\path\to\TrashCat
# Instrumented APK (built locally, never committed)
PG_APK_PATH=C:\path\to\trashcat.apk
# Android package name of the game
PG_ANDROID_PACKAGE=com.DefaultCompany.TrashCat
# AltTester Desktop built-in server; over USB the phone reaches it through `adb reverse tcp:13000 tcp:13000`
PG_ALTTESTER_HOST=127.0.0.1
PG_ALTTESTER_PORT=13000
# Serial of the test device from `adb devices -l`; leave empty to use the only attached device
PG_ADB_SERIAL=

# --- Persistence (Phase 1+) ---
# Postgres URL (Supabase or local). Phase 1 runs Postgres 16 in Docker on 127.0.0.1:5433, e.g.
#   postgresql://pg:<password>@127.0.0.1:5433/proving_ground
# Create the schema with `uv run alembic upgrade head`.
DATABASE_URL=

# --- LLM (Phase 1+) ---
# Phase 1: Google Gemini API free tier (provider gemini, model gemini-3.8-flash); key from Google AI Studio
PG_LLM_PROVIDER=gemini
PG_LLM_MODEL=gemini-3.8-flash
PG_LLM_API_KEY=
# Per-million-token prices from the provider's pricing page (0 on a free tier). Never hard-coded.
PG_LLM_INPUT_USD_PER_MTOK=0
PG_LLM_OUTPUT_USD_PER_MTOK=0
PG_LLM_TEMPERATURE=0.4
PG_LLM_MAX_OUTPUT_TOKENS=16000
PG_LLM_TIMEOUT_S=180
# Hard cap on LLM spend per generation run; the run aborts cleanly when it would be exceeded
PG_MAX_COST_PER_RUN_USD=1.00

# --- Control-plane API (Phase 2; `pg api serve` locally, Render in production) ---
# Signs the admin session cookie and local-storage URLs: at least 32 random characters
PG_SESSION_SECRET=
# argon2 hash of the admin password, from `uv run pg api hash-password`; empty = admin login off
PG_ADMIN_PASSWORD_HASH=
# Shared secret for the build-registration webhook (also a GitHub Actions secret); empty = off
PG_WEBHOOK_SECRET=
# Public read-only demo pages (no login, no artifacts, no actions)
PG_PUBLIC_DEMO=false
# Secure cookies need https; set false only for local http development
PG_SECURE_COOKIES=true
# Proxies in front of the API that append to X-Forwarded-For (0 locally)
PG_TRUSTED_PROXY_HOPS=0
# Object storage for APK parts and run artifacts: local (development) or supabase
PG_STORAGE_BACKEND=local
PG_LOCAL_STORAGE_DIR=artifacts/storage
# How agents and the CLI reach this API (used in local-storage URLs)
PG_PUBLIC_BASE_URL=http://127.0.0.1:8000
# Supabase project URL and service-role key: on the API host only, never on the device agent
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
PG_STORAGE_BUCKET=proving-ground
# Run the pg_worker loop inside the API process (ADR-0010)
PG_EMBEDDED_WORKER=false
# Limits (defaults shown): request body bytes, requests per minute per client IP
PG_MAX_BODY_BYTES=2000000
PG_RATE_PUBLIC_PER_MIN=120
PG_RATE_WEBHOOK_PER_MIN=30
PG_RATE_LOGIN_PER_MIN=10
PG_RATE_AGENT_PER_MIN=600
# Job lease (s), seconds per RUN_TEST attempt, largest n a validation may request
PG_LEASE_TTL_S=120
PG_RUN_TIMEOUT_S=300
PG_MAX_CANDIDATES=12
