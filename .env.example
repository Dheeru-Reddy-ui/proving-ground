# Copy to .env (gitignored) and fill in. Never commit .env or put secrets anywhere else.

# --- Game and device (Phase 0+) ---
# Unity project for TrashCat, kept OUTSIDE this repo; read-only except the edits listed in game/HOOKS.md
PG_GAME_PROJECT_DIR=C:\path\to\TrashCat
# Instrumented APK (built locally, never committed)
PG_APK_PATH=C:\path\to\trashcat.apk
# Android package name of the game
PG_ANDROID_PACKAGE=com.DefaultCompany.TrashCat
# AltTester Desktop built-in server; over USB the phone reaches it through `adb reverse tcp:13000 tcp:13000`
PG_ALTTESTER_HOST=127.0.0.1
PG_ALTTESTER_PORT=13000
# Serial of the test device from `adb devices -l`; leave empty to use the only attached device
PG_ADB_SERIAL=

# --- Persistence (Phase 1+) ---
# Postgres URL (Supabase or local)
DATABASE_URL=

# --- LLM (Phase 1+) ---
PG_LLM_PROVIDER=
PG_LLM_MODEL=
PG_LLM_API_KEY=
# Hard cap on LLM spend per generation run; the run aborts cleanly when it would be exceeded
PG_MAX_COST_PER_RUN_USD=1.00
